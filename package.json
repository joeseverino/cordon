{
  "name": "cordon-spec",
  "version": "2.1.0",
  "description": "Cordon — a language-agnostic command-surface contract: declare a tool once, render every view from it, and carry each command's blast radius so agents can risk-gate before they act.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "bin": {
    "cordon-checks": "dist/checks/run.js",
    "cordon-validate": "dist/conformance/validate.js",
    "cordon-emit": "dist/emitters/node/cli.js",
    "cordon-gate": "dist/harness/gate.js",
    "cordon-admission": "dist/admission/verify.js",
    "cordon-admission-create": "dist/admission/create.js",
    "cordon-admission-evidence": "dist/admission/evidence.js",
    "cordon-admission-lock": "dist/admission/lock.js"
  },
  "exports": {
    "./emit": {
      "types": "./dist/emitters/node/index.d.ts",
      "default": "./dist/emitters/node/index.js"
    },
    "./harness": {
      "types": "./dist/harness/policy.d.ts",
      "default": "./dist/harness/policy.js"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "schema/",
    "fixtures/",
    "checks/config.schema.json",
    "checks/lib/shellcheck-repo.sh",
    "docs/EMITTERS.md",
    "docs/IMPLEMENTERS.md",
    "docs/REUSABLE-GATE.md",
    "docs/PLUGIN-ADMISSION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p .",
    "test": "node --test",
    "checks": "node checks/run.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeseverino/cordon.git"
  }
}
