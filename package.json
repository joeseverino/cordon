{
  "name": "cordon-spec",
  "version": "1.4.0",
  "description": "Cordon \u2014 a language-agnostic command-surface contract: declare a tool once, render every view from it, and carry each command's blast radius so agents can risk-gate before they act.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node conformance/validate.mjs && node checks/selftest.mjs && node admission/selftest.mjs",
    "checks": "node checks/run.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "files": [
    "schema/",
    "admission/",
    "checks/",
    "conformance/",
    "harness/",
    "fixtures/",
    "docs/EMITTERS.md",
    "docs/IMPLEMENTERS.md",
    "docs/REUSABLE-GATE.md",
    "docs/PLUGIN-ADMISSION.md"
  ],
  "bin": {
    "cordon-checks": "checks/run.mjs",
    "cordon-validate": "conformance/validate.mjs",
    "cordon-admission-create": "admission/create.mjs",
    "cordon-admission-evidence": "admission/evidence.mjs",
    "cordon-admission-lock": "admission/lock.mjs",
    "cordon-admission": "admission/verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeseverino/cordon.git"
  }
}
