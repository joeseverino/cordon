#!/usr/bin/env bash
# pre-push — never push red. Runs the self-tests and cordon's checks over this
# repo, which is what the gate runs in CI. Emergency bypass: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

[[ -f package.json ]] || exit 0
echo "pre-push: npm test, then cordon checks"
if ! npm test --silent || ! node checks/run.ts --root .; then
    echo "✗ Gate failed — push aborted. Fix it, or bypass: git push --no-verify" >&2
    exit 1
fi
